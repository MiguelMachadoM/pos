<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.pos_config_shop_identity</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting
                    id="pos_shop_identity_setting"
                    string="Custom ticket header identity"
                    help="Print a shop name, address, phone and email on this POS receipt instead of the company ones. VAT and website stay those of the company."
                >
                    <field name="pos_shop_identity_enabled" />
                    <div
                        class="content-group mt16"
                        invisible="not pos_shop_identity_enabled"
                    >
                        <field name="pos_shop_identity_country_id" invisible="1" />
                        <field name="pos_shop_identity_zip" invisible="1" />
                        <div class="row mt16">
                            <label
                                for="pos_shop_identity_name"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_shop_identity_name" class="col-lg-8" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_shop_identity_street"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_shop_identity_street" class="col-lg-8" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_shop_identity_street2"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_shop_identity_street2" class="col-lg-8" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_shop_identity_zip_id"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                name="pos_shop_identity_zip_id"
                                class="col-lg-8"
                                placeholder="ZIP, city, state"
                                options="{'no_create': True, 'no_open': True}"
                                domain="[('country_id', '=?', pos_shop_identity_country_id)]"
                            />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_shop_identity_city"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_shop_identity_city" class="col-lg-8" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_shop_identity_state_id"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                name="pos_shop_identity_state_id"
                                class="col-lg-8"
                                options="{'no_open': True}"
                                domain="[('country_id', '=?', pos_shop_identity_country_id)]"
                            />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_shop_identity_phone"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_shop_identity_phone" class="col-lg-8" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_shop_identity_email"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_shop_identity_email" class="col-lg-8" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
