#. module: pos_config_shop_identity
#: model:ir.model.fields,help:pos_config_shop_identity.field_pos_config__shop_identity_enabled
msgid ""
"If enabled, this POS prints the shop name, address, phone and email below "
"instead of the company ones. VAT and website stay those of the company."
msgstr ""
"Si está activo, este TPV imprime el nombre, la dirección, el teléfono y el "
"correo de la tienda en lugar de los de la empresa. El NIF y la web siguen "
"siendo los de la empresa."

#. module: pos_config_shop_identity
#: model:ir.model.fields,field_description:pos_config_shop_identity.field_pos_config__shop_identity_phone
#: model:ir.model.fields,field_description:pos_config_shop_identity.field_res_config_settings__pos_shop_identity_phone
msgid "Phone"
msgstr "Teléfono"

#. module: pos_config_shop_identity
#: model_terms:ir.ui.view,arch_db:pos_config_shop_identity.res_config_settings_view_form
msgid ""
"Print a shop name, address, phone and email on this POS receipt instead of "
"the company ones. VAT and website stay those of the company."
msgstr ""
"Imprime nombre, dirección, teléfono y correo de la tienda en el ticket de "
"este TPV en lugar de los de la empresa. El NIF y la web siguen siendo los de "
"la empresa."

