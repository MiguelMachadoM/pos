<odoo>
    <record
        id="res_config_settings_view_form_pos_product_flexible_search"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.view.form.inherit.pos.product.flexible.search</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting
                    id="pos_product_flexible_search_min_chars"
                    string="POS product search"
                    help="Minimum characters in the product search box before client-side filtering runs."
                >
                    <field name="pos_pos_product_search_min_chars" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
