#. module: pos_product_flexible_search
#: model:ir.model.fields,field_description:pos_product_flexible_search.field_pos_config__pos_product_search_min_chars
#: model:ir.model.fields,field_description:pos_product_flexible_search.field_res_config_settings__pos_pos_product_search_min_chars
msgid "POS: minimum characters for product search"
msgstr "TPV: mínimo de caracteres para buscar producto"

#. module: pos_product_flexible_search
#: model:ir.model.fields,help:pos_product_flexible_search.field_pos_config__pos_product_search_min_chars
#: model:ir.model.fields,help:pos_product_flexible_search.field_res_config_settings__pos_pos_product_search_min_chars
msgid ""
"The POS client-side product filter runs only when the search text has at least "
"this many characters. Use 0 to filter from the first character (heavy on large catalogs)."
msgstr ""
"El filtro de producto en el TPV solo se aplica cuando el texto de búsqueda tiene al menos "
"este número de caracteres. Use 0 para filtrar desde el primer carácter (puede ser pesado en catálogos muy grandes)."

#. module: pos_product_flexible_search
#: model_terms:ir.ui.view,arch_db:pos_product_flexible_search.res_config_settings_view_form_pos_product_flexible_search
msgid "Minimum characters in the product search box before client-side filtering runs."
msgstr ""
"Mínimo de caracteres en el cuadro de búsqueda de producto antes de aplicar el filtrado en el cliente."

#. module: pos_product_flexible_search
