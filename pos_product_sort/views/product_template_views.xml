<odoo>
    <record id="product_template_form_pos_sequence" model="ir.ui.view">
        <field name="name">product.template.form.pos.sequence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="sequence" />
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_pos_sequence" model="ir.ui.view">
        <field name="name">product.template.tree.pos.sequence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="sequence" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
