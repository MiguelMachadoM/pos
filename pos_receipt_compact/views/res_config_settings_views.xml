<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.pos_receipt_compact</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@id='pos_bills_and_receipts_section']"
                position="inside"
            >
                <setting
                    id="pos_receipt_compact_setting"
                    string="Compact ticket"
                    help="Font sizes per ticket section, smaller order number, and hide the quantity line when the qty is 1."
                >
                    <div class="content-group mt16">
                        <div class="row mt8">
                            <label
                                for="pos_receipt_font_header"
                                string="Header"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_receipt_font_header" class="col-lg-4" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_receipt_font_tracking"
                                string="Order number"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_receipt_font_tracking" class="col-lg-4" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_receipt_font_lines"
                                string="Product lines"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_receipt_font_lines" class="col-lg-4" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_receipt_font_totals"
                                string="Totals"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_receipt_font_totals" class="col-lg-4" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="pos_receipt_font_footer"
                                string="Footer"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_receipt_font_footer" class="col-lg-4" />
                        </div>
                        <div class="row mt16">
                            <label
                                for="pos_receipt_hide_unit_qty"
                                string="Hide qty when 1"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="pos_receipt_hide_unit_qty" class="col-lg-4" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
