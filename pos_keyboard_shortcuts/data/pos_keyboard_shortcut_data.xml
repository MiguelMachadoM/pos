<odoo noupdate="1">
    <record id="shortcut_search" model="pos.keyboard.shortcut">
        <field name="action">search</field>
        <field name="key">b</field>
        <field name="scope">product</field>
        <field name="sequence">10</field>
    </record>
    <record id="shortcut_customer" model="pos.keyboard.shortcut">
        <field name="action">customer</field>
        <field name="key">c</field>
        <field name="scope">product</field>
        <field name="sequence">20</field>
    </record>
    <record id="shortcut_discount_line" model="pos.keyboard.shortcut">
        <field name="action">discount_line</field>
        <field name="key">d</field>
        <field name="scope">product</field>
        <field name="sequence">30</field>
    </record>
    <record id="shortcut_price" model="pos.keyboard.shortcut">
        <field name="action">price</field>
        <field name="key">p</field>
        <field name="scope">product</field>
        <field name="sequence">40</field>
    </record>
    <record id="shortcut_quantity" model="pos.keyboard.shortcut">
        <field name="action">quantity</field>
        <field name="key">q</field>
        <field name="scope">product</field>
        <field name="sequence">50</field>
    </record>
    <record id="shortcut_discount_global" model="pos.keyboard.shortcut">
        <field name="action">discount_global</field>
        <field name="key">g</field>
        <field name="scope">product</field>
        <field name="sequence">60</field>
    </record>
    <record id="shortcut_tickets" model="pos.keyboard.shortcut">
        <field name="action">tickets</field>
        <field name="key">t</field>
        <field name="scope">product</field>
        <field name="sequence">70</field>
    </record>
    <record id="shortcut_refund" model="pos.keyboard.shortcut">
        <field name="action">refund</field>
        <field name="key">r</field>
        <field name="scope">product</field>
        <field name="sequence">80</field>
    </record>
    <record id="shortcut_pricelist" model="pos.keyboard.shortcut">
        <field name="action">pricelist</field>
        <field name="key">l</field>
        <field name="scope">product</field>
        <field name="sequence">90</field>
    </record>
    <record id="shortcut_fiscal" model="pos.keyboard.shortcut">
        <field name="action">fiscal</field>
        <field name="key">i</field>
        <field name="scope">product</field>
        <field name="sequence">100</field>
    </record>
    <record id="shortcut_note" model="pos.keyboard.shortcut">
        <field name="action">note</field>
        <field name="key">n</field>
        <field name="scope">product</field>
        <field name="sequence">110</field>
    </record>
    <record id="shortcut_remove_line" model="pos.keyboard.shortcut">
        <field name="action">remove_line</field>
        <field name="key">x</field>
        <field name="scope">product</field>
        <field name="sequence">120</field>
    </record>
    <record id="shortcut_help" model="pos.keyboard.shortcut">
        <field name="action">help</field>
        <field name="key">h</field>
        <field name="scope">global</field>
        <field name="sequence">130</field>
    </record>
    <record id="shortcut_cancel_order" model="pos.keyboard.shortcut">
        <field name="action">cancel_order</field>
        <field name="key">c</field>
        <field name="ctrl" eval="True" />
        <field name="alt" eval="True" />
        <field name="scope">global</field>
        <field name="sequence">140</field>
    </record>
    <record id="shortcut_pay_cash" model="pos.keyboard.shortcut">
        <field name="action">pay_cash</field>
        <field name="key">e</field>
        <field name="scope">payment</field>
        <field name="sequence">150</field>
    </record>
    <record id="shortcut_pay_bank" model="pos.keyboard.shortcut">
        <field name="action">pay_bank</field>
        <field name="key">t</field>
        <field name="scope">payment</field>
        <field name="sequence">160</field>
    </record>
    <record id="shortcut_print_receipt" model="pos.keyboard.shortcut">
        <field name="action">print_receipt</field>
        <field name="key">i</field>
        <field name="scope">payment</field>
        <field name="sequence">170</field>
    </record>
    <record id="shortcut_invoice" model="pos.keyboard.shortcut">
        <field name="action">invoice</field>
        <field name="key">f</field>
        <field name="scope">payment</field>
        <field name="sequence">180</field>
    </record>
    <record id="shortcut_print_basic" model="pos.keyboard.shortcut">
        <field name="action">print_basic</field>
        <field name="key">b</field>
        <field name="scope">receipt</field>
        <field name="sequence">190</field>
    </record>
</odoo>
